{
  "manifest_version": 3,
  "name": "Copy YouTube Transcript",
  "version": "1.1.0",
  "description": "One click copies the transcript of the current YouTube video to the clipboard.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Copy YouTube Transcript settings",
    "default_popup": "src/options.html"
  },
  "options_ui": {
    "page": "src/options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/settings-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/transcript.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
